{
  "schemaVersion": 1,
  "id": "noflamesmoke",
  "version": "${version}",
  "name": "No Flame & Smoke",
  "description": "Toggle the flame/smoke particles for torches, candles and furnaces.",
  "authors": ["SAH", "Tex"],
  "license": "MIT",
  "icon": "assets/noflamesmoke/icon.png",
  "environment": "client",

  "entrypoints": {
    "client": ["com.sah.noflamesmoke.NoFlameSmokeMod"],
    "modmenu": ["com.sah.noflamesmoke.integration.ModMenuEntry"]
  },

  "mixins": [
    "noflamesmoke.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1.2 <26.4",
    "fabric-api": "*"
  },

  "suggests": {
    "modmenu": ">=20.0.0-beta.4"
  },

  "contact": {
    "homepage": "https://sahproject.co.uk",
    "sources": "https://github.com/SAHProject/NoFlameSmoke",
    "issues": "https://github.com/SAHProject/NoFlameSmoke/issues"
  }
}